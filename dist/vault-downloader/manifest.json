{
  "manifest_version": 3,
  "name": "Vault Downloader",
  "version": "1.1.0",
  "version_name": "1.1.0-beta.1",
  "description": "Download authorized 3D model files from Creality Cloud, MakerWorld, and Printables into one ZIP.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "downloads", "offscreen", "storage"],
  "host_permissions": [
    "https://www.crealitycloud.com/*",
    "https://*.crealitycloud.com/*",
    "https://makerworld.com/*",
    "https://*.makerworld.com/*",
    "https://api.printables.com/*",
    "https://www.printables.com/*",
    "https://media.printables.com/*",
    "https://files.printables.com/*",
    "https://makerworld.bblmw.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Vault Downloader", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://www.crealitycloud.com/*/model-detail/*", "https://www.crealitycloud.com/model-detail/*", "https://makerworld.com/*/models/*", "https://makerworld.com/models/*", "https://www.printables.com/*/model/*", "https://www.printables.com/model/*"],
    "js": ["cache-lifetime.js"],
    "run_at": "document_start"
  }]
}
